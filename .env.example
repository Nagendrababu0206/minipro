PARKVISION_SECRET=replace-with-a-long-random-secret
PARKVISION_WEIGHTS=models/best.pt
PARKVISION_CONFIDENCE=0.35

# Public browser key; restrict by HTTP referrer and enabled Google Maps APIs.
GOOGLE_MAPS_BROWSER_KEY=

# Optional administrator login (must match an existing account username)
PARKVISION_ADMIN_USERNAME=your-admin-username
# Freshness window for manually verified occupancy
PARKVISION_OCCUPANCY_MAX_AGE_SECONDS=900
